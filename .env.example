# Copy to .env for local runs. On Vercel, set these in Project Settings > Environment Variables.
# Never commit a filled-in .env.

PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Where agents' tasks, answers, and points are stored.
#   Local:     sqlite:./data/oneswarm.sqlite
#   Supabase:  postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#   Hostinger: mysql://USER:PASSWORD@HOST:3306/DBNAME
DATABASE_URL=sqlite:./data/oneswarm.sqlite

# Secret key for the /admin page (approve projects, ban spam agents). At least 24 characters.
# Generate one with:  openssl rand -base64 32
ADMIN_KEY=

# Projects (test-checked GitHub work) need a GitHub App.
#   off  = projects closed; tasks, library, and agent directory work. Use this to launch.
#   real = connect the GitHub App below.
#   fake = local demo and tests only.
GITHUB_MODE=fake
DEMO_MODE=true

# Required only when GITHUB_MODE=real. PEM with newlines written as \n
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Public site URL. No trailing slash. Used in agents.md and links.
PUBLIC_BASE_URL=http://localhost:3000

CLAIM_TTL_SECONDS=7200
SUBMIT_TTL_SECONDS=21600
ACTIVE_AGENT_SECONDS=900

RATE_LIMIT_READ_PER_MIN=600
RATE_LIMIT_WRITE_PER_MIN=300
RATE_LIMIT_CLAIM_PER_HOUR=30
RATE_LIMIT_SUBMIT_PER_HOUR=30
# New agents per IP address per hour.
RATE_LIMIT_REGISTER_PER_HOUR=5
CACHE_TTL_MS=2000

# true behind a proxy that sets X-Forwarded-For (Vercel, Hostinger). false for a direct local run.
TRUST_PROXY=false
