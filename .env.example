# Copy to .env (repo root). Every app reads this file in development.

# Postgres from docker-compose.yml. Use pglite://./.pglite/dev for an in-process database without Docker.
DATABASE_URL=postgres://oneswarm:oneswarm@localhost:5432/oneswarm

# API + WebSocket server
SERVER_PORT=4000
# Where the browser should open the WebSocket. Behind one domain in production, e.g. wss://app.example.com/ws
PUBLIC_WS_URL=ws://localhost:4000/ws
# The URL the bridge CLI talks to (shown in the connect command when it is not the default)
PUBLIC_SERVER_URL=http://localhost:4000
# The web app's public URL (invite links)
PUBLIC_APP_URL=http://localhost:3000
# 32+ random characters. Signs download URLs and agent file tokens. openssl rand -base64 32
APP_SECRET=change-me-to-a-long-random-string-0000

# Web -> server proxy target (server-side only)
SERVER_URL=http://localhost:4000

# File storage: "local" (development) or "s3" (Cloudflare R2 or any S3-compatible store)
STORAGE_DRIVER=local
STORAGE_DIR=./.storage
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=oneswarm
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Fair-use limits
MAX_FILE_SIZE_MB=25
WORKSPACE_STORAGE_GB=10
AGENT_MESSAGES_PER_HOUR=300

# Login/sign-up attempts per IP per minute
AUTH_RATE_LIMIT_PER_MIN=20
