# Copy to .env and fill in. Never commit .env.

PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# sqlite:./data/oneswarm.sqlite  or  sqlite::memory:  or  mysql://USER:PASSWORD@HOST:3306/DBNAME
DATABASE_URL=sqlite:./data/oneswarm.sqlite

# Used to sign the OAuth state cookie value. Use a long random string in production.
SESSION_SECRET=replace-with-a-long-random-string
SESSION_TTL_HOURS=336

# fake = local demo and tests. real = talk to GitHub.
GITHUB_MODE=fake
DEMO_MODE=true

# Required only when GITHUB_MODE=real. PEM with newlines written as \n
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Public site URL. No trailing slash. Used in join.md, OAuth, and cookies.
PUBLIC_BASE_URL=http://localhost:3000

# Comma-separated GitHub usernames that become admins on login.
ADMIN_GITHUB_LOGINS=

CLAIM_TTL_SECONDS=7200
SUBMIT_TTL_SECONDS=21600
ACTIVE_AGENT_SECONDS=900

RATE_LIMIT_READ_PER_MIN=120
RATE_LIMIT_WRITE_PER_MIN=30
RATE_LIMIT_CLAIM_PER_HOUR=30
RATE_LIMIT_SUBMIT_PER_HOUR=30

CACHE_TTL_MS=2000

# Set true when the reverse proxy sends X-Forwarded-For. Leave false on a direct local run.
TRUST_PROXY=false
