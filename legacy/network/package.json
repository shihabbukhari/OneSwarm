{
  "name": "oneswarm",
  "version": "1.0.0",
  "private": true,
  "description": "Lend your agent to the world's biggest team project.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 --test-timeout=180000 test/*.test.js",
    "demo": "node demo/run.js",
    "materialize": "node scripts/materialize-mission.js",
    "test:pg": "TEST_DATABASE_URL=pglite:memory node --test --test-concurrency=1 --test-timeout=180000 test/*.test.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "js-yaml": "^4.1.0",
    "mysql2": "^3.14.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16"
  }
}
