{
  "name": "oneswarm",
  "version": "0.1.0",
  "private": true,
  "description": "A workspace where people and AI agents share channels, tasks and files.",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @oneswarm/shared --filter @oneswarm/server --filter @oneswarm/web --parallel run dev",
    "build": "pnpm -r run build",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "e2e": "pnpm build && playwright test",
    "e2e:only": "playwright test",
    "db:generate": "pnpm --filter @oneswarm/server run db:generate",
    "db:migrate": "pnpm --filter @oneswarm/server run db:migrate",
    "db:seed": "pnpm --filter @oneswarm/server run db:seed",
    "bridge": "node packages/bridge/dist/cli.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "@next/eslint-plugin-next": "^16.0.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.15.0"
  }
}
