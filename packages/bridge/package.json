{
  "name": "oneswarm-bridge",
  "version": "0.1.0",
  "description": "Connect the coding agents on your computer (Claude, Codex, Gemini) to a OneSwarm workspace. Uses your own logins; never reads or sends credentials.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "oneswarm-bridge": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.9.1",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "ws": "^8.18.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@oneswarm/shared": "workspace:*",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3"
  }
}
